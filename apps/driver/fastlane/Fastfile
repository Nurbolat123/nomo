# Run from this app's folder:  fastlane ios beta | fastlane android beta | … release
#
# Required environment:
#   iOS:     APPLE_ID, APPLE_TEAM_ID, APP_STORE_CONNECT_API_KEY_PATH (App Store Connect API key JSON)
#   Android: PLAY_JSON_KEY, and android/key.properties for the upload keystore
#   Both:    API_URL (production backend), PRIVACY_URL, TERMS_URL

def dart_defines
  %w[API_URL PRIVACY_URL TERMS_URL SUPPORT_PHONE TILE_URL]
    .select { |k| ENV[k] && !ENV[k].empty? }
    .map { |k| "--dart-define=#{k}=#{ENV[k]}" }
    .join(" ")
end

def build_number
  ENV["BUILD_NUMBER"] || Time.now.strftime("%y%m%d%H%M")
end

platform :ios do
  def build_ios
    sh("cd .. && flutter build ipa --release --build-number=#{build_number} #{dart_defines} --export-options-plist=ios/ExportOptions.plist")
  end

  desc "Build and upload to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]) if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    build_ios
    upload_to_testflight(api_key: api_key, ipa: Dir["../build/ios/ipa/*.ipa"].first, skip_waiting_for_build_processing: true)
  end

  desc "Build, upload and submit for App Store review"
  lane :release do
    api_key = app_store_connect_api_key(key_filepath: ENV["APP_STORE_CONNECT_API_KEY_PATH"]) if ENV["APP_STORE_CONNECT_API_KEY_PATH"]
    build_ios
    upload_to_app_store(
      api_key: api_key,
      ipa: Dir["../build/ios/ipa/*.ipa"].first,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false },
    )
  end
end

platform :android do
  def build_android
    sh("cd .. && flutter build appbundle --release --build-number=#{build_number} #{dart_defines}")
  end

  desc "Build and upload to the internal testing track"
  lane :beta do
    build_android
    upload_to_play_store(track: "internal", aab: "../build/app/outputs/bundle/release/app-release.aab", release_status: "draft")
  end

  desc "Build and upload to production (staged 20% rollout)"
  lane :release do
    build_android
    upload_to_play_store(track: "production", rollout: "0.2", aab: "../build/app/outputs/bundle/release/app-release.aab")
  end
end
