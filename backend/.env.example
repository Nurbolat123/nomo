# Copy to .env and fill in. Never commit .env.
ADDR=:8080
DATABASE_URL=postgres://nomo:nomo@localhost:5432/nomo?sslmode=disable
REDIS_ADDR=localhost:6379
PUBLIC_URL=http://localhost:8080
UPLOAD_DIR=./uploads
CURRENCY=KZT

# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=dev-secret-change-me
ACCESS_TTL=30m
REFRESH_TTL=720h

ADMIN_EMAIL=admin@nomo.local
ADMIN_PASSWORD=admin

# Reviewer demo: this phone signs in with DEMO_CODE and every order is served by a bot driver.
DEMO_MODE=true
DEMO_PHONE=+77000000000
DEMO_CODE=0000
DEMO_DRIVER_PHONE=+77000000001

OFFER_TIMEOUT=15s
SEARCH_TIMEOUT=3m

# Firebase Cloud Messaging (leave empty to only log pushes)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
